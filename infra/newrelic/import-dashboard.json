{
  "name": "Import — Observabilidade",
  "description": "Funil de import (aquisição): descoberta DJEN, enriquecimento DATAJUD, ingestão nacional, filas asynq, erros por kind e runtime Go. Construído sobre lib/telemetry + internal/acquisition/metrics.go. accountIds já setados para a conta 8336829 — troque se importar em outra conta.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Funil de import",
      "description": "Quanto o import descobre e landa, ponta a ponta.",
      "widgets": [
        {
          "title": "Processos descobertos (novos vs revistos)",
          "layout": { "column": 1, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.court_records) FACET state TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Andamentos novos landados",
          "layout": { "column": 5, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.docket_entries_new) TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Intimações landadas (novas vs revistas)",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.intimations) FACET state TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Enriquecimentos DATAJUD aplicados",
          "layout": { "column": 1, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.enrichments_applied) TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Diário nacional landado (ingestão)",
          "layout": { "column": 5, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.diario_publications) TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Match: publicações folded em tenants",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.match_publications) TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Resumo (24h)",
          "layout": { "column": 1, "row": 7, "width": 12, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.court_records) AS 'processos', sum(import.docket_entries_new) AS 'andamentos', sum(import.intimations) AS 'intimações', sum(import.diario_publications) AS 'diário' SINCE 1 day ago" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Externo & Filas",
      "description": "DJEN/DATAJUD (latência, 429) e profundidade das filas asynq.",
      "widgets": [
        {
          "title": "Mix de status DJEN",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.djen_requests) FACET status_class TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Taxa de 429 DJEN (rate-block)",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT sum(import.djen_requests) WHERE status_class = '429' TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Latência DJEN request (p50/p95/p99, ms)",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE name = 'djen.request_page' TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Latência DATAJUD (p95, ms)",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Span SELECT percentile(duration.ms, 95) WHERE name = 'datajud.fetch_by_number' TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Profundidade de fila asynq (por fila/estado)",
          "layout": { "column": 1, "row": 7, "width": 6, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT latest(asynq.queue.depth) FACET queue, state TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Backlog pendente por fila",
          "layout": { "column": 7, "row": 7, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT latest(asynq.queue.depth) WHERE state = 'pending' FACET queue TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Erros & Runtime",
      "description": "Falhas por error.kind e saúde de runtime Go dos binários.",
      "widgets": [
        {
          "title": "Falhas do import por kind e span",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Span SELECT count(*) WHERE error.kind IS NOT NULL AND (name LIKE 'acquisition.%' OR name LIKE 'djen.%' OR name LIKE 'datajud.%' OR name LIKE 'scheduler %') FACET error.kind, name SINCE 1 day ago" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Taxa de erro dos consumers de import",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Span SELECT percentage(count(*), WHERE otel.status_code = 'ERROR') WHERE name LIKE 'acquisition.%process' TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Goroutines por serviço",
          "layout": { "column": 1, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT latest(go.goroutine.count) FACET service.name TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Memória usada por serviço",
          "layout": { "column": 5, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT latest(go.memory.used) FACET service.name TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Latência de scheduling Go (p95)",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [{ "accountIds": [8336829], "query": "FROM Metric SELECT percentile(go.schedule.duration, 95) FACET service.name TIMESERIES" }],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    }
  ]
}
