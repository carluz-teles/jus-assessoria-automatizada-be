# jus-assessoria — backend · variáveis de ambiente
# Copie para .env (dev) e preencha. Em produção o Railway injeta como env var.
# Segredos NUNCA são commitados — este arquivo só tem placeholders.
# Fonte de verdade: docs/erd-backend.md §5b.4.

# Postgres (pgx/v5). DSN completo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jusassessoria?sslmode=disable

# Redis (asynq broker).
REDIS_URL=redis://localhost:6379/0

# Clerk — auth (Org = tenant). Secret server-side; nunca no cliente.
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Opcionais: issuer esperado do JWT (vazio = aceita o issuer padrão da instância)
# e segredo do webhook Clerk (svix). Vazio só quebra ao verificar um webhook.
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# Anthropic — chave da API de IA (worker-ai).
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OpenTelemetry — endpoint OTLP do coletor.
# New Relic US: otlp.nr-data.net:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# New Relic: api-key=<sua-license-key INGEST-LICENSE>
OTEL_EXPORTER_OTLP_HEADERS=
# local collector sem TLS; deixe false/omita para New Relic (TLS)
OTEL_EXPORTER_OTLP_INSECURE=true

# Nível mínimo de log de TODO binário: debug|info|warn|error (default info).
# debug liga os logs por-evento do relay (qual evento publicado) sem redeploy.
LOG_LEVEL=info

# Object storage S3-compatível (S3/R2/MinIO). Opcionais: o api só monta o
# storage.Client quando bucket+region+credenciais estão todos presentes
# (config.S3Enabled). S3_ENDPOINT vazio = AWS real; preencha para R2/MinIO.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=jus-assessoria-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_USE_PATH_STYLE=true é OBRIGATÓRIO pra MinIO; R2/S3 default false.
S3_USE_PATH_STYLE=

# TSA (RFC 3161 TimeStamp Protocol) usado no PAdES-T. Opcional: vazio =
# PAdES-BASIC (sem carimbo de tempo; data da assinatura = clock do assinante).
# Preencher = draft.Sign chama a TSA e embute o TimeStampToken → verificadores
# mostram data confiável e cadeia OCSP. Provedor dev: http://freetsa.org/tsr
# (grátis). Prod estável: http://timestamp.digicert.com.
TSA_URL=

# GCP Cloud KMS — envelope encryption dos certificados A1 (.pfx). Formato:
# projects/<PROJECT_ID>/locations/<REGION>/keyRings/<KEYRING>/cryptoKeys/<KEY>
# Sem essa var, o slice certificate NÃO sobe (endpoints /v1/certificates
# retornam 404). Requer também GOOGLE_APPLICATION_CREDENTIALS apontando pro
# JSON da service account (com role roles/cloudkms.cryptoKeyEncrypterDecrypter
# na key acima). Ver docs/erd-*.md — setup via gcloud descrito no README.
GCP_KMS_KEY_NAME=
# Application Default Credentials — 2 formas mutuamente exclusivas:
#
# DEV (Docker Compose): caminho absoluto do JSON. O compose monta o arquivo
# dentro do container em /run/secrets/gcp-kms.json e sobrescreve esta var:
# GOOGLE_APPLICATION_CREDENTIALS=/home/USUARIO/jus-api-kms.json
#
# PROD (Railway/Fly/Render): NÃO USE esta var; ela não permite montar arquivo.
# Em vez disso, seta GCP_KMS_CREDENTIALS_JSON abaixo com o BASE64 do arquivo.
# O boot decodifica, escreve em /tmp/gcp-kms.json e injeta esta var
# automaticamente. Gerar: `base64 -w0 ~/jus-api-kms.json | pbcopy`.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_KMS_CREDENTIALS_JSON=

# Certificado digital A1 (slice certificate) — COFRE de chave (envelope encryption).
# A chave privada do .pfx NUNCA é armazenada em texto plano: uma DEK aleatória cifra
# o blob com AES-256-GCM e a DEK é embrulhada pelo cofre. Seleção do cofre (nenhum é
# `required` globalmente — os demais binários sobem sem eles; se nenhum estiver setado
# o api sobe SEM o endpoint de certificado):
#   AWS_KMS_KEY_ID setado  → cofre KMS   (produção)
#   senão CERT_KEK setado  → cofre local (dev)
#
# CERT_KEK: KEK AES-256 em base64 (32 bytes decodificados). Gere com:
#   openssl rand -base64 32
# É segredo — nunca commitar. Só o cofre LOCAL (dev) a usa.
CERT_KEK=
# AWS_KMS_KEY_ID: id ou ARN da CMK simétrica que embrulha a DEK (produção). A região
# do KMS reusa S3_REGION quando CERT_KMS_REGION é vazia; as credenciais reusam
# S3_ACCESS_KEY/S3_SECRET_KEY (mesmo provider AWS já configurado) — ou o IAM role do
# ambiente se elas estiverem vazias.
AWS_KMS_KEY_ID=
CERT_KMS_REGION=

# Cofre genérico de segredos por tenant (lib/vault + tabela tenant_secret) — usado
# hoje pela seed TOTP do slice court (court_connection.mfa_seed_ref). Sem esta var,
# os endpoints /v1/court-connections* não sobem (precisam TAMBÉM de GCP_KMS_KEY_NAME,
# já que autenticam com o certificado A1 do advogado). Gere com:
#   openssl rand -base64 32
# É segredo — nunca commitar.
VAULT_KEK_BASE64=

# HTTP — porta do api (default 8080).
PORT=8080

# Ambiente da aplicação: development | production (default: development).
APP_ENV=development

# Billing checkout/portal redirects (só o api, nos endpoints /v1/billing/checkout|portal).
# O FE lê ?checkout=success|canceled|return só como gatilho de refetch (nunca como verdade).
APP_BILLING_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
APP_BILLING_CANCEL_URL=http://localhost:3000/settings/billing?checkout=canceled
APP_BILLING_RETURN_URL=http://localhost:3000/settings/billing?checkout=return

# BILLING_GATE_ENABLED — TEMPORÁRIO: liga o enforcement do limite de processos ativos
# (api + worker-ingestao). Default false enquanto a precificação dos planos não é
# decidida (decisão de negócio pendente) — ninguém é bloqueado. Religar quando a
# precificação for definida.
BILLING_GATE_ENABLED=false

# FE (opcional — só usado por `make up-full` / docker-compose.fe.yml, que soma o
# repo irmão ../jus-assessoria-automatizada-fe à stack local). Mesma instância
# Clerk do backend. Não usado pelo `api` nem pelos workers.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# ngrok (opcional — só usado por `make up-tunnel` / docker-compose.tunnel.yml, que
# expõe o api publicamente pro webhook do Clerk alcançar localhost). Free tier:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=<your-ngrok-authtoken>
